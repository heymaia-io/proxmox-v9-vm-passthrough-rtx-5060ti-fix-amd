#!/bin/sh
# Hook de initramfs-tools: antepone una tabla ACPI IVRS parcheada al initramfs.
#
# Instalar en: /etc/initramfs-tools/hooks/acpi_ivrs_override  (chmod +x)
#
# Proposito: neutralizar las reservas IVMD del firmware que marcan require_direct=1
# sobre el dispositivo que quieres pasar a una VM, y que hacen que VFIO falle con
# "Firmware has requested this device have a 1:1 IOMMU mapping".
#
# Al vivir como hook, el override se re-aplica solo en cada update-initramfs, o sea
# que sobrevive a las actualizaciones de kernel.
#
# ROLLBACK: borrar este archivo y correr `update-initramfs -u -k $(uname -r)`.

PREREQ=""

prereqs()
{
    echo "$PREREQ"
}

case $1 in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

CPIO=/usr/local/lib/acpi-override/acpi_ivrs_override.cpio

if [ ! -r "${CPIO}" ]; then
    echo "W: acpi_ivrs_override: ${CPIO} no existe, no se aplica el override" >&2
    exit 0
fi

prepend_earlyinitramfs "${CPIO}"

:

#!/bin/sh
# initramfs-tools hook: prepend a patched ACPI IVRS table to the initramfs.
#
# Install to: /etc/initramfs-tools/hooks/acpi_ivrs_override  (chmod +x)
#
# Purpose: neutralise the firmware's IVMD reservations that set require_direct=1
# on the device you want to pass through to a VM, and which make VFIO fail with
# "Firmware has requested this device have a 1:1 IOMMU mapping".
#
# Living as a hook means the override is re-applied on every update-initramfs,
# so it survives kernel updates.
#
# ROLLBACK: delete this file and run `update-initramfs -u -k $(uname -r)`.

PREREQ=""

prereqs()
{
    echo "$PREREQ"
}

case $1 in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

CPIO=/usr/local/lib/acpi-override/acpi_ivrs_override.cpio

if [ ! -r "${CPIO}" ]; then
    echo "W: acpi_ivrs_override: ${CPIO} not found, override not applied" >&2
    exit 0
fi

prepend_earlyinitramfs "${CPIO}"

:
